# Copiá este archivo a .env.local (o usá el .env que deja el enlace de Cursor).
# Nunca subas claves al repositorio.
# No uses prefijo NEXT_PUBLIC_ en las claves de Supabase: irían al navegador.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Analytics (opcional). Único valor público esperado, formato G-XXXXXXXX.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX
